# Copy this file, rename the copy to .env, and paste your real key.
# Get a key at https://console.anthropic.com (Settings -> API keys)
ANTHROPIC_API_KEY=paste_your_key_here

# Model used by the agents (Jac/byLLM format: provider/model).
# claude-haiku-5-5 is the cheapest current Claude model.
# Set to mockllm for the free offline demo (no key, no cost).
MTO_MODEL=anthropic/claude-haiku-5-5
